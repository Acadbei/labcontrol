# Lokal konfiguratsiya namunasi. Qiymatlarni server muhiti yoki maxfiy sozlama omborida bering.
NODE_ENV=development
PORT=3000
LABCONTROL_DEMO_MODE=false

# Hozirgi JSON ombori faqat bitta jarayonli sinov/lokal foydalanish uchun.
LABCONTROL_DATABASE_FILE=./data/production.database.json
LABCONTROL_SESSION_FILE=./data/sessions.json
LABCONTROL_UPLOADS_DIR=./data/uploads
# Optional: defaults to %LOCALAPPDATA%\LabControl\credentials.json on Windows,
# otherwise credentials.json next to the configured database file.
LABCONTROL_CREDENTIALS_FILE=

# data/xodim.txt dagi yetti rol profili production DB birinchi ochilganda yaratiladi.
# Loginlar ism_familiya ko‘rinishida; email ham login uchun qabul qilinadi.
# Kirish uchun har bir hisobga Argon2id password hash kerak; MFA bu loyihada o‘chirilgan.
# Qiymatlarni repoga, .env fayliga yoki brauzerga yozmang; server secret manager/environment’dan bering.
LABCONTROL_PASSWORD_HASHES_JSON={}
LABCONTROL_PUBLIC_ORIGIN=http://localhost:3000
# Optional additional exact origins for LAN/domain access through a reverse proxy.
LABCONTROL_ALLOWED_ORIGINS=http://192.168.40.75,https://miyya.uz

# PostgreSQL is optional migration tooling only; the application runtime still uses JSON.
# Keep the password and connection string in a private environment file, never in source control.
POSTGRES_PASSWORD=
DATABASE_URL=

# Mahalliy Ollama faqat sozlamalarda tanlanganda so‘rov va ruxsatli manba parchalarini oladi.
# Model javobi manba belgilarini bermasa, chat model matnini qabul qilmay, parchalarni ko‘rsatadi.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_ALLOWED_HOSTS=
# Docker Compose ichidagi Ollama servisidan foydalanish uchun `--profile ollama` bilan ishga tushiring
# va muhit faylida LABCONTROL_OLLAMA_URL_DOCKER=http://ollama:11434 hamda OLLAMA_ALLOWED_HOSTS=ollama belgilang.
LABCONTROL_OLLAMA_URL_DOCKER=

# Chatbot mahalliy Ollama va ichki bazadan uzluksiz foydalanadi (OLLAMA_URL orqali).
# Ixtiyoriy tashqi zaxira provayder:
OPENROUTER_API_KEY=
LABCONTROL_OPENROUTER_MODEL=openrouter/free

# TTS ovoz xizmati doimiy bepul Edge-TTS (uz-UZ-MadinaNeural va uz-UZ-SardorNeural)
# va brauzer Web Speech API orqali ishlaydi. Hech qanday tashqi API kalit talab qilinmaydi.
